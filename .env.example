# Переменные Railway (Variables). Файл .env в репозиторий не кладите.
DISCORD_TOKEN=токен-бота
OWNER_DISCORD_ID=ваш-discord-id
ADMIN_DISCORD_IDS=id1,id2
DISCORD_GUILD_ID=id-сервера-discord
SAMP_HOST=ip-игрового-сервера
SAMP_PORT=7777
SAMP_RCON_PASSWORD=как-rcon_password-в-server.cfg
# вход через Google и логи сервера (бот заменяет отдельный stage_api.py)
LOG_SECRET=как-log_secret-в-stage_discord.cfg
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
LOG_HTTP_HOST=0.0.0.0
LOG_HTTP_PORT=8099
